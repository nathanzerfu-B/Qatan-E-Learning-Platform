# ==============================================================================
# Qatan Backend Environment Variables Example
# Duplicate this file as .env and fill in the corresponding values
# ==============================================================================

# Server Configuration
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/qatan_db?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"

# Email Services (Nodemailer / Gmail SMTP)
VERIFICATION_EMAIL_USER="your-verification-email@gmail.com"
VERIFICATION_EMAIL_PASS="your-gmail-app-password"
INSTRUCTOR_EMAIL_USER="your-instructor-inbox@gmail.com"
INSTRUCTOR_EMAIL_PASS="your-gmail-app-password"
CONTACT_INBOX="your-support-inbox@gmail.com"

# Chapa Payment Gateway (Ethiopian Payments)
CHAPA_PUBLIC_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx"
CHAPA_ENCRYPTION_KEY="your-chapa-encryption-key"

# Cloudinary Media Storage (Thumbnails, Videos, Profile Avatars)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Google OAuth2 (Optional / Gmail Integration)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_OAUTH_REDIRECT="http://localhost:5000/api/auth/google/callback"

# Discord Bot Integration (Role Assignment & Course Channels)
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:5000/api/auth/discord/callback"
DISCORD_GUILD_ID="your-discord-guild-id"
DISCORD_INSTRUCTOR_ROLE_ID="your-instructor-role-id"
DISCORD_STUDENT_ROLE_ID="your-student-role-id"
